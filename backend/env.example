# Database
MONGO_URI=mongodb://localhost:27017/robert-ai

# Server
PORT=5000
FRONTEND_URL=http://localhost:3000
BASE_URL=http://localhost:5000
AGENT_SERVICE_URL=http://localhost:3002

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_NUMBER=+44123456789

# JWT
JWT_SECRET=your_jwt_secret_here

# Web Search (Brave Search API)
BRAVE_SEARCH_API_KEY=your_brave_search_api_key

# GDPR & Privacy
DATA_RETENTION_DAYS=90
PII_MASKING_ENABLED=true

# Observability
LOG_LEVEL=info
METRICS_ENABLED=true
ALERTING_ENABLED=true

# MCP Tools
MCP_TOOLS_ENABLED=true
WEB_SEARCH_RATE_LIMIT=100
CALENDAR_RATE_LIMIT=50
EMAIL_RATE_LIMIT=30
CRM_RATE_LIMIT=20
PAYMENTS_RATE_LIMIT=10

# Browser Agent
BROWSER_AGENT_ENABLED=true
CRM_LOGIN_URL=https://takeabyte.co.uk/InContact/Account/Login
CRM_HOME_URL=https://takeabyte.co.uk/InContact
CRM_LOGIN_NAME=universalmct
CRM_USERNAME=auagent
# Required for browser agent; no default - set in vault or env
CRM_PASSWORD=
CRM_USER_AGENT=auagent
CRM_ANTIFORGERY_COOKIE=your_antiforgery_cookie_value_here
CRM_SESSION_COOKIE=your_session_cookie_value_here

# Multilingual
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,fr,de,es,it,pt,nl,pl

# Security
ENCRYPTION_KEY=your_encryption_key_here
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
# Set FORCE_HTTPS=1 behind a TLS-terminating proxy to redirect HTTP to HTTPS and set HSTS
FORCE_HTTPS=0

# Audio & Telephony
AUDIO_QUALITY=high
VAD_THRESHOLD=0.5
VAD_PADDING_MS=500
BARGE_IN_ENABLED=true

# File Search
FILE_SEARCH_MAX_RESULTS=5
FILE_SEARCH_TIMEOUT_MS=5000

# Performance
AI_RESPONSE_TIMEOUT_MS=10000
TOOL_EXECUTION_TIMEOUT_MS=15000
MAX_CONCURRENT_CALLS=50
